# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://growth_os:growth_os@localhost:5432/growth_os?schema=public"

# Required in production. Generate at least 32 random bytes; never commit the value.
SESSION_SECRET="replace-with-a-secure-random-value"

# Public application URL, without a trailing slash.
APP_URL="http://localhost:3000"

# Explicit runtime environment.
NODE_ENV="development"
